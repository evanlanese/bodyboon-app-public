{
  "name": "bodyboon",
  "private": true,
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build:dev": "node --env-file=dev.env node_modules/webpack/bin/webpack.js --env development --node-env development",
    "build:prod": "node --env-file=prod.env node_modules/webpack/bin/webpack.js --env production --node-env production",
    "start:dev": "NODE_ENV=development nodemon --env-file=dev.env server.js",
    "start:prod": "NODE_ENV=production nodemon --env-file=prod.env server.js",
    "build": "node --env-file=dev.env node_modules/webpack/bin/webpack.js --env development --node-env development",
    "start": "NODE_ENV=development node --env-file=dev.env server.js",
    "gcloud": "gcloud run deploy"
  },
  "engines": {
    "node": "^20.9.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true,
      "es2024": true
    }
  },
  "dependencies": {
    "@lit/context": "^1.1.0",
    "@lit/task": "^1.0.0",
    "@vaadin/router": "^1.7.5",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "firebase": "^10.6.0",
    "firebase-admin": "^11.11.0",
    "lit": "^3.1.0",
    "mongodb": "^6.3.0",
    "stripe": "^14.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "babel-loader": "^9.1.3",
    "eslint": "^8.54.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
