# Copy to dev.env / prod.env and fill in. Never commit the filled-in files.

# --- Server: Firebase Admin (service account) ---
FB_ADMIN_PROJECT_ID=
FB_ADMIN_PRIVATE_KEY_ID=
FB_ADMIN_PRIVATE_KEY=
FB_ADMIN_CLIENT_EMAIL=
FB_ADMIN_CLIENT_ID=
FB_ADMIN_CLIENT_X509_CERT_URL=

# --- Server: MongoDB Atlas ---
URI=
DATABASE=
COLLECTION=

# --- Server: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_KEY=
SUCCESS_URL=
CANCEL_URL=
AUTOMATIC_TAX=false

# --- Server: secret used to pseudonymize emails in logs (any long random string) ---
LOG_HASH_SECRET=

# --- Server: optional basic auth gate for staging ---
BETA_AUTH_USER=
BETA_AUTH_PASSWORD=

# --- Shared: Stripe price IDs (used by server validation and client build) ---
ANNUAL_PRICE_ID=
MONTHLY_PRICE_ID=

# --- Client build (bundled into the browser by webpack) ---
FB_CLIENT_API_KEY=
FB_CLIENT_AUTH_DOMAIN=
FB_CLIENT_PROJECT_ID=
FB_CLIENT_STORAGE_BUCKET=
FB_CLIENT_MESSAGING_SENDER_ID=
FB_CLIENT_APP_ID=
SIGNUP_ACTION_URL=
STRIPE_BILLING_PORTAL=
